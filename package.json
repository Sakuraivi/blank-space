{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "build:standalone": "node scripts/build-standalone.mjs",
    "deploy:standalone": "node node_modules/wrangler/bin/wrangler.js deploy --config wrangler.standalone.jsonc",
    "test:standalone": "node --test server/standalone-worker.test.mjs",
    "test:clarity": "node --test ai/clarity.test.mjs ai/clarity-turn.test.mjs ai/clarity-expression.test.mjs ai/clarity-verbatim.test.mjs ai/clarity-grounding.test.mjs ai/clarity-state.test.mjs ai/clarity-wait.test.mjs ai/clarity-diagnostics.test.mjs server/clarity-api.test.mjs server/request-timing.test.mjs server/diagnostics.test.mjs scripts/clarity-evaluation.test.mjs",
    "test:clarity-materials": "node --test ai/experiments/clarity-materials.test.mjs ai/experiments/clarity-material-runtime.test.mjs scripts/clarity-materials-evaluation.test.mjs server/clarity-preparation.test.mjs scripts/experiments/clarity-material-live.test.mjs",
    "test:clarity-material-set": "node --test ai/experiments/clarity-material-set.test.mjs scripts/experiments/clarity-material-v2-live.test.mjs",
    "test:clarity-retention": "node --test ai/experiments/clarity-retention-ledger.test.mjs ai/experiments/clarity-retained-concern.test.mjs scripts/clarity-retention-replay.test.mjs",
    "evaluate:clarity-retention": "node scripts/clarity-retention-replay.mjs",
    "test:clarity-retention-live": "node --test scripts/experiments/clarity-retention-v3-worker.test.mjs scripts/experiments/clarity-retention-v3-live.test.mjs",
    "evaluate:clarity-retention-live": "node scripts/experiments/clarity-retention-v3-live.mjs",
    "test:clarity-guided": "node --test ai/experiments/clarity-guided-reflect.test.mjs ai/experiments/clarity-faithful-retained-concern.test.mjs scripts/experiments/clarity-retention-v4-worker.test.mjs scripts/experiments/clarity-retention-v4-live.test.mjs",
    "evaluate:clarity-guided": "node scripts/experiments/clarity-retention-v4-live.mjs",
    "test:clarity-duration": "node --test ai/experiments/clarity-duration-source.test.mjs ai/experiments/clarity-source-checked.test.mjs scripts/experiments/clarity-retention-v5-worker.test.mjs scripts/experiments/clarity-retention-v5-live.test.mjs",
    "evaluate:clarity-duration": "node scripts/experiments/clarity-retention-v5-live.mjs",
    "test:clarity-dialogue": "node --test ai/experiments/clarity-faithful-dialogue.test.mjs scripts/experiments/clarity-retention-v6-worker.test.mjs",
    "evaluate:clarity-dialogue": "node scripts/experiments/clarity-retention-v6-live.mjs",
    "test:clarity-semantic-audit": "node --test ai/experiments/clarity-semantic-audit.test.mjs scripts/experiments/clarity-semantic-audit-worker.test.mjs",
    "evaluate:clarity-semantic-audit": "node scripts/experiments/clarity-semantic-audit-live.mjs",
    "test:clarity-relation-plan": "node --test ai/experiments/clarity-relation-plan.test.mjs scripts/experiments/clarity-relation-plan-worker.test.mjs",
    "evaluate:clarity-relation-plan": "node scripts/experiments/clarity-relation-plan-live.mjs",
    "test:clarity-example-review": "node --test ai/experiments/clarity-example-review.test.mjs scripts/experiments/clarity-example-review-worker.test.mjs",
    "evaluate:clarity-example-review": "node scripts/experiments/clarity-example-review-live.mjs",
    "evaluate:clarity-materials": "node scripts/clarity-materials-evaluation.mjs",
    "dev:clarity": "node scripts/clarity-preview.mjs",
    "dev:clarity-fixture": "node scripts/clarity-preview.mjs --fixture",
    "test:clarity-listening": "node --test ai/clarity-v3-intent.test.mjs ai/clarity-v3-online-intent.test.mjs ai/clarity-v3-contract.test.mjs ai/clarity-v3.test.mjs ai/clarity-v3-correction.test.mjs ai/clarity-v3-ownership.test.mjs ai/clarity-v3-state.test.mjs ai/clarity-v3-owned-review.test.mjs server/clarity-v3-api.test.mjs scripts/clarity-v3-preview.test.mjs",
    "dev:clarity-listening": "node scripts/clarity-v3-preview.mjs",
    "dev:clarity-listening:fixture": "node scripts/clarity-v3-preview.mjs --fixture",
    "test:clarity-model-comparison": "node --test ai/experiments/clarity-model-comparison.test.mjs scripts/experiments/clarity-model-comparison-worker.test.mjs scripts/experiments/clarity-model-comparison-live.test.mjs",
    "evaluate:clarity-model-comparison": "node scripts/experiments/clarity-model-comparison-live.mjs",
    "test:clarity-v3-compatibility": "node --test ai/experiments/clarity-v3-compatibility.test.mjs scripts/experiments/clarity-v3-compatibility-probe.test.mjs",
    "evaluate:clarity-v3-compatibility": "node scripts/experiments/clarity-v3-compatibility-probe.mjs",
    "test:clarity-v3-native": "node --test scripts/experiments/clarity-v3-native-fixtures.test.mjs scripts/experiments/clarity-v3-native-worker.test.mjs scripts/experiments/clarity-v3-native-live.test.mjs",
    "evaluate:clarity-v3-native": "node scripts/experiments/clarity-v3-native-live.mjs",
    "verify:migration": "node scripts/standalone/verify-ledger.mjs",
    "test:migration": "node --test scripts/standalone/verify-ledger.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
